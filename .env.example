# Frontend environment. Only VITE_* variables reach the browser, so never put
# secrets here. Africa's Talking credentials live in backend/.env only.

# Origin of the NestJS API. Leave empty when the app and API share a host
# (Vite dev proxy, or nginx in docker-compose) — requests then go to /api.
VITE_API_URL=

# Dev only: where `npm run dev` proxies /api.
VITE_DEV_API_PROXY=http://localhost:3000
